# FoundryOS Environment Configuration Template
# Copy to .env.development, .env.test, or .env.production as needed.
# DO NOT COMMIT WORKING SECRETS.

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=development
FOUNDRYOS_TIMEZONE=Asia/Kuala_Lumpur

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=foundryos
POSTGRES_USER=foundryos_app
POSTGRES_PASSWORD=replace_with_secure_runtime_password

# Flyway Migration Identity (Separate from runtime)
FOUNDRYOS_MIGRATION_JDBC_URL=jdbc:postgresql://postgres:5432/foundryos
FOUNDRYOS_MIGRATION_USER=foundryos_migrator
FOUNDRYOS_MIGRATION_PASSWORD=replace_with_secure_migrator_password

# JWT Security
# Path to PEM formatted RS256 private/public key files
JWT_PRIVATE_KEY_PATH=/etc/foundryos/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/foundryos/keys/jwt_public.pem
# Fallback secret for local development if keys not mounted
JWT_DEV_SECRET=development_only_secret_key_must_be_at_least_256_bits_long_for_security_12345

# Initial Bootstrap Secret (One-time Admin creation)
FOUNDRYOS_BOOTSTRAP_ENABLED=true
FOUNDRYOS_BOOTSTRAP_ADMIN_EMAIL=admin@foundryos.local
FOUNDRYOS_BOOTSTRAP_ADMIN_PASSWORD=AdminBootstrap2026!Secure

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Frontend
VITE_API_BASE_URL=/api/v1
